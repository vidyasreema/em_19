<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_collections" model="ir.module.category">
        <field name="name">Collections</field>
        <field name="sequence">8</field>
    </record>

    <record id="res_groups_privilege_collections" model="res.groups.privilege">
        <field name="name">Collections</field>
        <field name="category_id" ref="module_category_collections"/>
        <field name="sequence">10</field>
    </record>

    <!-- Appendix B: Collections user < Accountant < Manager / Owner -->
    <record id="group_collection_user" model="res.groups">
        <field name="name">Collections user</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_collections"/>
        <field name="comment">Sees the table and dashboard, adds notes, moves stages (with blocks), changes the assignee.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_collection_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_collections"/>
        <field name="comment">Also generates snapshots, records approvals and edits the credit limit.</field>
        <field name="implied_ids" eval="[(4, ref('group_collection_user'))]"/>
    </record>

    <record id="group_collection_manager" model="res.groups">
        <field name="name">Manager / Owner</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_collections"/>
        <field name="comment">Also archives snapshots and edits settings, pipelines, stages and note categories.</field>
        <field name="implied_ids" eval="[(4, ref('group_collection_accountant'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_collection_snapshot_company" model="ir.rule">
        <field name="name">Collection snapshot: multi-company</field>
        <field name="model_id" ref="model_collection_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_collection_snapshot_line_company" model="ir.rule">
        <field name="name">Collection snapshot line: multi-company</field>
        <field name="model_id" ref="model_collection_snapshot_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_collection_note_company" model="ir.rule">
        <field name="name">Collection note: multi-company</field>
        <field name="model_id" ref="model_collection_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_collection_approval_company" model="ir.rule">
        <field name="name">Collection approval: multi-company</field>
        <field name="model_id" ref="model_collection_approval"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

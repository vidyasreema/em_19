<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="collection_cycle_view_list" model="ir.ui.view">
        <field name="name">collection.cycle.list</field>
        <field name="model">collection.cycle</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days"/>
                <field name="max_stage_id"/>
                <field name="had_partial"/>
            </list>
        </field>
    </record>

    <record id="action_collection_cycle" model="ir.actions.act_window">
        <field name="name">Closed cycles</field>
        <field name="res_model">collection.cycle</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

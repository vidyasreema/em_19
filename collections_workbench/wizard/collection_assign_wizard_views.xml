<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="collection_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">collection.assign.wizard.form</field>
        <field name="model">collection.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Change the collections assignee of <strong><field name="line_count" class="oe_inline"/></strong> selected customers.
                   The new person is notified in their Inbox.</p>
                <group>
                    <field name="allowed_employee_ids" invisible="1"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="line_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Change assignee" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_collection_assign_wizard" model="ir.actions.act_window">
        <field name="name">Change collections assignee</field>
        <field name="res_model">collection.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_order_source" model="ir.ui.view">
        <field name="name">res.config.settings.form.order.source</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_purchase_journey.res_config_settings_view_form_purchase_journey"/>
        <field name="arch" type="xml">
            <setting id="purchase_journey_setting" position="after">
                <setting id="order_source_setting" string="Ask how customers heard about us"
                         help="After ordering, the confirmation page asks &quot;How did you hear about us?&quot;. The answer is saved on the order and in its history.">
                    <field name="order_source_question"/>
                    <div class="mt-2">
                        <button name="%(website_order_source.action_website_order_sources)d" type="action"
                                string="Answers" class="btn-link" icon="oi-arrow-right"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>

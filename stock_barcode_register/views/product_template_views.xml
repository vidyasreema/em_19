<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_barcode_register" model="ir.ui.view">
        <field name="name">product.template.form.barcode.register</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_barcode_register" type="object"
                        class="oe_stat_button" icon="fa-barcode"
                        invisible="type != 'consu'" groups="stock.group_stock_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="barcode_register_count"/> /
                            <field name="barcode_register_qty"/>
                        </span>
                        <span class="o_stat_text">Unsold Cartons</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="view_template_property_form_barcode_register" model="ir.ui.view">
        <field name="name">product.template.stock.property.form.barcode.register</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="storage_type"/>
                <field name="barcode_alert_days"/>
            </xpath>
        </field>
    </record>
</odoo>

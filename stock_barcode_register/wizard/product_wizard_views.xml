<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_product_wizard_form" model="ir.ui.view">
        <field name="name">stock.barcode.product.wizard.form</field>
        <field name="model">stock.barcode.product.wizard</field>
        <field name="arch" type="xml">
            <form string="New Product">
                <field name="picking_id" invisible="1"/>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="uom_id" options="{'no_create': True}"/>
                        <field name="categ_id" options="{'no_create': True}"/>
                        <field name="storage_type"/>
                    </group>
                    <group>
                        <field name="standard_price"/>
                        <field name="product_uom_qty"/>
                        <field name="default_code"/>
                        <field name="barcode"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not duplicate_ids">
                    <strong>Possible duplicates.</strong> Check these products before creating a new one.
                </div>
                <field name="duplicate_ids" invisible="not duplicate_ids" readonly="1">
                    <list>
                        <field name="display_name" string="Product"/>
                        <field name="default_code"/>
                        <field name="barcode"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <field name="confirm_not_duplicate" invisible="not duplicate_ids"/>
                <label for="confirm_not_duplicate" invisible="not duplicate_ids"/>
                <footer>
                    <button name="action_create" string="Create and Add to Receipt" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

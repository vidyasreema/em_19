<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_program_view_form_short_code" model="ir.ui.view">
        <field name="name">loyalty.program.form.short.code</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='trigger']" position="after">
                <field name="short_code" placeholder="e.g. SECOND10"
                       invisible="program_type not in ('coupons', 'next_order_coupons')"/>
            </xpath>
        </field>
    </record>
</odoo>

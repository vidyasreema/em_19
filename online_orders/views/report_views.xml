<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery quality (Annex 3 D5 / Annex 4 task 12): standard Pivot and Graph -->
    <record id="sale_order_view_pivot_online_quality" model="ir.ui.view">
        <field name="name">sale.order.pivot.online.quality</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Quality" sample="1">
                <field name="online_zone_id" type="row"/>
                <field name="online_order_hour" type="col"/>
                <field name="online_on_time_rate" type="measure"/>
                <field name="online_delivery_minutes" type="measure"/>
                <field name="online_delay_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_order_view_graph_online_quality" model="ir.ui.view">
        <field name="name">sale.order.graph.online.quality</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <graph string="Delivery Quality" type="bar" sample="1">
                <field name="online_zone_id"/>
                <field name="online_on_time_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_online_orders_quality" model="ir.actions.act_window">
        <field name="name">Delivery Quality</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- Delivered orders only: cancelled orders are reported separately -->
        <field name="domain">[('website_id', '!=', False), ('online_delivered_date', '!=', False), ('state', '!=', 'cancel')]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="sale_order_view_search_online"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sale_order_view_pivot_online_quality')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('sale_order_view_graph_online_quality')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale_order_view_list_online')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No delivered orders yet</p>
            <p>On-time rate, duration and delay of delivered website orders, by zone and order hour.</p>
        </field>
    </record>

    <record id="action_online_orders_cancellations" model="ir.actions.act_window">
        <field name="name">Cancellations by Reason</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('website_id', '!=', False), ('stage_id.code', '=', 'cancelled')]</field>
        <field name="context">{'create': False, 'pivot_row_groupby': ['online_cancel_reason'], 'pivot_measures': ['__count'], 'graph_groupbys': ['online_cancel_reason']}</field>
        <field name="search_view_id" ref="sale_order_view_search_online"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale_order_view_list_online')})]"/>
    </record>

    <!-- Email templates of the stages, for Marketing -->
    <record id="action_online_orders_mail_templates" model="ir.actions.act_window">
        <field name="name">Email Templates</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', 'in', ['sale.order', 'res.partner'])]</field>
        <field name="context">{'default_model': 'sale.order', 'search_default_name': 'Online Orders'}</field>
    </record>
</odoo>

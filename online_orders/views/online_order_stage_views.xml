<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="online_order_stage_view_list" model="ir.ui.view">
        <field name="name">online.order.stage.list</field>
        <field name="model">online.order.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fold"/>
                <field name="mail_template_id"/>
                <field name="activity_user_id" optional="show"/>
                <field name="portal_label"/>
            </list>
        </field>
    </record>

    <record id="online_order_stage_view_form" model="ir.ui.view">
        <field name="name">online.order.stage.form</field>
        <field name="model">online.order.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Preparing"/></h1>
                    </div>
                    <group>
                        <group string="Board">
                            <field name="sequence"/>
                            <field name="fold"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="When an order enters this stage">
                            <field name="mail_template_id" context="{'default_model': 'sale.order'}"/>
                            <field name="activity_user_id"/>
                            <field name="activity_summary" invisible="not activity_user_id"/>
                        </group>
                        <group string="Customer (My Orders)">
                            <field name="portal_label" placeholder="Same as the stage name"/>
                            <field name="portal_color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_online_order_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">online.order.stage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a stage to the Online Orders board</p>
            <p>An extra stage (without role) can have its own email template and activity.</p>
        </field>
    </record>
</odoo>

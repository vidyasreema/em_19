<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Roles (Annex 4, section 5) ───────────────────────────────── -->
    <record id="res_groups_privilege_online_orders" model="res.groups.privilege">
        <field name="name">Online Orders</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_online_orders_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_online_orders"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Orders board, order page, customer card (add and edit addresses).</field>
    </record>

    <record id="group_online_orders_management" model="res.groups">
        <field name="name">Management</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_online_orders"/>
        <field name="implied_ids" eval="[(4, ref('group_online_orders_sales'))]"/>
        <field name="comment">Sales + delivery quality report, deleting addresses, stage settings.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="res_groups_privilege_online_orders_marketing" model="res.groups.privilege">
        <field name="name">Online Orders Marketing</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_online_orders_marketing" model="res.groups">
        <field name="name">Marketing</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_online_orders_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_online_orders_sales')), (4, ref('mail.group_mail_template_editor'))]"/>
        <field name="comment">Sales + delivery quality report and editing the email templates.</field>
    </record>

    <!-- ── Product cost, hidden by access rights ────────────────────────
         Users of Sales, Inventory, Accounting (and Purchase, Manufacturing,
         POS, see post_init_hook) keep seeing it. Online Orders users who
         have none of these apps don't. -->
    <record id="group_product_cost" model="res.groups">
        <field name="name">See Product Cost</field>
        <field name="comment">Can read the Cost of products.</field>
    </record>
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost'))]"/>
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost'))]"/>
    </record>
    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost'))]"/>
    </record>
    <record id="account.group_account_readonly" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost'))]"/>
    </record>

    <!-- ── Record rules ─────────────────────────────────────────────── -->
    <record id="sale_order_rule_online_orders" model="ir.rule">
        <field name="name">Online Orders: website orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('website_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_online_orders_sales'))]"/>
    </record>
    <record id="sale_order_line_rule_online_orders" model="ir.rule">
        <field name="name">Online Orders: website order lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.website_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_online_orders_sales'))]"/>
    </record>
</odoo>

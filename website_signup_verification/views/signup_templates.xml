<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Annex 3A 1.3: an email with an account gets this message, not an error -->
    <template id="signup_account_exists" inherit_id="auth_signup.signup" name="Sign-up: you already have an account">
        <xpath expr="//p[hasclass('alert-danger')]" position="before">
            <div t-if="signup_account_exists" class="alert alert-info o_signup_account_exists" role="status">
                You already have an account.
                <a t-attf-href="/web/login?{{ keep_query('redirect', login=signup_account_exists) }}">Sign in</a>
                or <a t-attf-href="/web/reset_password?{{ keep_query('redirect', login=signup_account_exists) }}">reset your password</a>.
            </div>
        </xpath>
    </template>

    <!-- Annex 3A task 2: enter the code from the email -->
    <template id="signup_verify" name="Sign-up: verification code">
        <t t-call="web.login_layout">
            <div t-if="expired" class="oe_signup_form o_signup_verify_expired">
                <p class="alert alert-warning" role="alert">This sign-up has expired. Please sign up again.</p>
                <div class="d-grid">
                    <a href="/web/signup" class="btn btn-primary">Sign up</a>
                </div>
            </div>
            <div t-else="" class="oe_signup_form o_signup_verify">
                <h4 class="mb-2">Check your email</h4>
                <p class="text-muted">
                    We sent a 6-digit code to <strong t-out="verification.email"/>.
                    It is valid for 10 minutes.
                </p>
                <form method="post" action="/web/signup/verify" class="o_signup_verify_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label for="signup_code" class="form-label">Verification code</label>
                        <input type="text" name="code" id="signup_code" class="form-control form-control-lg text-center"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*"
                               required="required" autofocus="autofocus" placeholder="123456"/>
                    </div>
                    <t t-if="ask_password" t-call="auth_signup.fields"/>
                    <p t-if="error" class="alert alert-danger o_signup_verify_error" role="alert" t-out="error"/>
                    <p t-elif="sent == '1'" class="alert alert-success" role="status">We sent a new code.</p>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary o_signup_verify_btn">
                            <t t-if="ask_password">Create my account</t>
                            <t t-else="">Confirm</t>
                        </button>
                    </div>
                </form>
                <form method="post" action="/web/signup/verify/resend" class="mt-3 text-center">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <span class="small text-muted">Didn't get it? Check your spam folder, or</span>
                    <button t-if="can_resend" type="submit" class="btn btn-link btn-sm p-0 align-baseline o_signup_resend">resend the code</button>
                    <span t-elif="resend_wait" class="small text-muted">ask for a new code in <t t-out="resend_wait"/> seconds</span>
                    <span t-else="" class="small text-muted">sign up again</span>
                </form>
                <div class="text-center mt-2">
                    <a href="/web/signup" class="btn btn-link btn-sm">Use another email</a>
                </div>
            </div>
        </t>
    </template>
</odoo>

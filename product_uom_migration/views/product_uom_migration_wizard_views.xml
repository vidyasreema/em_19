<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_uom_migration_wizard_form" model="ir.ui.view">
        <field name="name">product.uom.migration.wizard.form</field>
        <field name="model">product.uom.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Migrate Unit of Measure">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="new_uom_id"/>
                    <field name="conversion_factor"/>
                    <field name="allow_negative_stock"/>
                </group>
                <footer>
                    <button name="action_confirm_migration" type="object"
                            string="Confirm Migration" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_uom_migration_wizard" model="ir.actions.act_window">
        <field name="name">Migrate Unit of Measure</field>
        <field name="res_model">product.uom.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_product_ids': active_ids}</field>
    </record>

</odoo>
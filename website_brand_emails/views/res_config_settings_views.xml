<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_brand_emails" model="ir.ui.view">
        <field name="name">res.config.settings.form.brand.emails</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="online_orders.res_config_settings_view_form_online_orders"/>
        <field name="arch" type="xml">
            <setting id="online_orders_email_from_setting" position="after">
                <setting id="brand_emails_setting" string="The Cut design for customer emails"
                         help="Order, account and coupon emails of website customers in the design of this website (logo, card, footer). Untick to go back to the standard emails.">
                    <field name="brand_emails"/>
                </setting>
                <setting id="brand_email_logo_setting" string="Email logo" invisible="not brand_emails"
                         help="Logo at the top of the customer emails, as PNG or JPG (email apps do not show SVG). Empty: the website logo when it is not an SVG, else the website name.">
                    <field name="brand_email_logo" widget="image" class="w-auto" options="{'size': [0, 60]}"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>

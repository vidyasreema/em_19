<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Cut design around the customer emails: logo, light card, footer of the website
         (no "Powered by Odoo"). Same colours as the verification code email. -->
    <template id="mail_layout" name="The Cut: email layout">
<html t-att-lang="lang">
<head>
    <meta http-equiv="Content-Type" content="text/html charset=UTF-8"/>
</head>
<body style="margin: 0; padding: 0;">
<t t-set="subtype_internal" t-value="False"/>
<t t-call="mail.notification_preview"/>
<t t-set="brand" t-value="(record or message).env['website'].sudo()._brand_website_for(record)"/>
<t t-set="brand_name" t-value="brand.name if brand else (company.name if company else '')"/>
<div style="margin: 0; padding: 24px 12px; background-color: #EEEBE6; font-family: Arial, Helvetica, sans-serif; color: #1E1B19;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
           style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 18px; border-top: 4px solid #7A1F2B; border-collapse: separate;">
        <tr>
            <td align="center" style="padding: 24px 24px 4px 24px;">
                <t t-set="brand_logo_url" t-value="brand._brand_logo_url() if brand else ''"/>
                <img t-if="brand_logo_url" t-att-src="brand_logo_url" t-att-alt="brand_name"
                     style="height: 64px; width: auto; border: 0;"/>
                <div t-else="" style="font-size: 22px; font-weight: bold; color: #7A1F2B;" t-out="brand_name"/>
            </td>
        </tr>
        <tr>
            <td style="padding: 12px 28px 24px 28px; font-size: 14px; line-height: 1.5; color: #1E1B19;">
                <t t-out="message.body"/>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 14px 28px 22px 28px; border-top: 1px solid #E2DDD6; font-size: 12px; line-height: 1.6; color: #6A635E;">
                <strong style="color: #1E1B19;" t-out="brand_name"/>
                <t t-if="brand">
                    <br/>
                    <a t-att-href="brand.get_base_url()" style="color: #7A1F2B; text-decoration: none;"
                       t-out="brand.get_base_url().split('//')[-1]"/>
                    <t t-if="brand._brand_contact()"> · <t t-out="brand._brand_contact()"/></t>
                </t>
            </td>
        </tr>
    </table>
</div>
</body>
</html>
    </template>
</odoo>

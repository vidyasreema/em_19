<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_pack_selection.PackSelectionPopup">
        <Dialog title="props.title" size="'md'">
            <div class="d-flex flex-column gap-2">
                <t t-foreach="props.packs" t-as="pack" t-key="pack.id">
                    <button class="btn btn-light border d-flex justify-content-between py-3 px-3"
                            t-on-click="() => this.selectPack(pack)">
                        <span class="fw-bold" t-esc="pack.name"/>
                        <span t-esc="pack.qty + ' ' + props.uomName"/>
                    </button>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
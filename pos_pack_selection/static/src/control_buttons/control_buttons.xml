<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_pack_selection.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!props.showRemainingButtons || (ui.isSmall and props.showRemainingButtons)']" position="after">
            <button t-if="!props.showRemainingButtons"
                    t-att-class="buttonClass"
                    t-on-click="() => this.onClickPackSelection()">
                Pack
            </button>
        </xpath>
    </t>
</templates>
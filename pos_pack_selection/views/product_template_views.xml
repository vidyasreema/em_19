<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a "Pack Prices" tab to the product form -->
    <record id="product_template_form_view_pack_prices" model="ir.ui.view">
        <field name="name">product.template.form.pack.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pack Prices" name="pack_prices">
                    <field name="pack_price_ids"
                           context="{'default_applied_on': '1_product', 'default_compute_price': 'fixed'}">
                        <list editable="bottom">
                            <field name="pricelist_id" required="1"/>
                            <field name="pack_uom_id" required="1"
                                   domain="[('id', 'in', parent.uom_ids)]"/>
                            <field name="fixed_price" string="Pack Price"/>
                            <field name="applied_on" column_invisible="1"/>
                            <field name="compute_price" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
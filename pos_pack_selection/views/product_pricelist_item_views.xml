<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds the Pack field to the standard pricelist rule form -->
    <record id="product_pricelist_item_form_view_pack" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.pack</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='min_quantity']" position="after">
                <field name="product_pack_uom_ids" invisible="1"/>
                <field name="pack_uom_id"
                       placeholder="Leave empty for normal (loose) price"/>
            </xpath>
        </field>
    </record>
</odoo>
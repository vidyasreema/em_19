<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a Pack column to the order lines of a POS order (backend) -->
    <record id="view_pos_pos_form_pack" model="ir.ui.view">
        <field name="name">pos.order.form.pack</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']//field[@name='product_id']" position="after">
                <field name="pack_uom_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
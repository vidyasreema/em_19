<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header and footer of every page of the site (BRD 3.10): the pages of The
         Cut and the Odoo pages (shop, contact, cart, checkout, My Account) -->
    <template id="layout" inherit_id="website.layout" name="The Cut: header and footer" priority="90">
        <xpath expr="//head" position="inside">
            <t t-if="website.cut_pages_enabled">
                <!-- The Google Fonts stylesheet of the theme: connect early (Annex 3B, 6.2) -->
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <!-- The fonts of the header and the titles, early (served by the website) -->
                <link rel="preload" as="font" type="font/woff2" crossorigin=""
                      href="/website_the_cut_pages/static/src/fonts/anton.woff2"/>
                <link rel="preload" as="font" type="font/woff2" crossorigin=""
                      href="/website_the_cut_pages/static/src/fonts/capture_it.woff2"/>
            </t>
        </xpath>
        <!-- The colours, fonts and buttons of the new pages on the Odoo pages too -->
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'tc-site' if website.cut_pages_enabled else ''}" separator=" "/>
        </xpath>
        <xpath expr="//main" position="before">
            <t t-if="website.cut_pages_enabled and main_object and main_object._name == 'website.page' and main_object.url == '/contactus'"
               t-call="website_the_cut_pages.contact_hero"/>
        </xpath>
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-if" add="not website.cut_pages_enabled" separator=" and "/>
        </xpath>
        <xpath expr="//header[@id='top']" position="before">
            <t t-if="not no_header and website.cut_pages_enabled" t-call="website_the_cut_pages.header"/>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-if" add="not website.cut_pages_enabled" separator=" and "/>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="after">
            <t t-if="not no_footer and website.cut_pages_enabled" t-call="website_the_cut_pages.footer"/>
        </xpath>
    </template>

    <!-- Product page: the empty area between "Terms and Conditions" and the specifications
         (Odoo's Contact Us section, hidden on priced products) gets the delivery line -->
    <template id="product_delivery_line" inherit_id="website_sale.product" name="The Cut: product delivery line">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_contact')]" position="inside">
            <t t-set="tc_delivery_line" t-value="website.cut_pages_enabled and website._cut_product_delivery_line()"/>
            <p t-if="tc_delivery_line" class="tc-product-delivery mb-0">
                <i class="fa fa-truck me-2" role="presentation"/><t t-out="tc_delivery_line"/>
            </p>
        </xpath>
    </template>

    <!-- Shop cards: the photos are shown about 200 px wide (up to 300 px on a big screen), so
         the 512 px version is enough, also on phone screens; Odoo loads the 1024 px one (speed) -->
    <template id="products_item_image_size" inherit_id="website_sale.products_item" name="The Cut: card photo size">
        <xpath expr="//span[hasclass('oe_product_image_img_wrapper_primary')]" position="attributes">
            <attribute name="t-options">{'widget': 'image', 'preview_image': 'image_512', 'class': 'oe_product_image_img h-100 w-100'}</attribute>
        </xpath>
        <xpath expr="//span[hasclass('oe_product_image_img_wrapper_secondary')]" position="attributes">
            <attribute name="t-options">{'widget': 'image', 'preview_image': 'image_512', 'class': 'oe_product_image_img_secondary h-100 w-100'}</attribute>
        </xpath>
    </template>

    <!-- On phones the menu folds behind the menu button, so the header is one row -->
    <template id="header" name="The Cut: header">
        <header class="tc-header" style="background: #7E1416; color: #FFFFFF">
            <div class="tc-header-row">
                <a href="/" aria-label="The Cut home" class="tc-logo">
                    <img src="/website_the_cut_pages/static/src/img/logo_white.png" alt="The Cut, by Excellence Meats"
                         width="76" height="76"/>
                </a>
                <nav id="tc-nav" class="tc-nav" aria-label="Main menu">
                    <a href="/">HOME</a>
                    <a href="/shop">SHOP</a>
                    <a href="/delivery">DELIVERY</a>
                    <a href="/about-us">ABOUT</a>
                    <a href="/contactus">CONTACT</a>
                </nav>
                <ul class="tc-icons list-unstyled d-flex align-items-center gap-3 m-0 p-0">
                    <t t-call="website_sale.header_cart_link">
                        <t t-set="_icon" t-value="True"/>
                    </t>
                    <li>
                        <a t-att-href="'/web/login' if website.is_public_user() else '/my'"
                           t-att-aria-label="'Sign in' if website.is_public_user() else 'My account'">
                            <i class="fa fa-user-o" role="presentation"/>
                        </a>
                    </li>
                    <li class="tc-menu-item">
                        <button type="button" class="tc-menu-btn" aria-controls="tc-nav" aria-expanded="false" aria-label="Menu">
                            <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                                <path class="tc-menu-open-icon" d="M4 7h16M4 12h16M4 17h16"/>
                                <path class="tc-menu-close-icon" d="M6 6l12 12M18 6L6 18"/>
                            </svg>
                        </button>
                    </li>
                </ul>
            </div>
        </header>
    </template>

    <template id="footer" name="The Cut: footer">
        <t t-set="tc_contact" t-value="website._cut_contact()"/>
        <footer class="tc-footer tc-pattern-dark" style="background-color: #5A0E10; color: #FFFFFF">
            <div style="max-width: 1120px; margin: 0 auto; padding: 36px 24px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between">
                <div style="display: flex; flex-direction: column; gap: 8px; font-family: Anton, Impact, 'Arial Narrow', sans-serif; font-size: 22px; letter-spacing: 0.03em">
                    <span t-if="tc_contact['domain']" t-out="tc_contact['domain'].upper()"/>
                    <a t-if="tc_contact['whatsapp']" t-att-href="tc_contact['whatsapp_url'] or None"
                       style="display: flex; gap: 10px; align-items: center; text-decoration: none" aria-label="WhatsApp">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.2-4.5A9 9 0 1 1 21 12z"/></svg>
                        <t t-out="tc_contact['whatsapp']"/>
                    </a>
                    <a t-if="tc_contact['phone']" t-att-href="tc_contact['phone_url']"
                       style="display: flex; gap: 10px; align-items: center; text-decoration: none" aria-label="Phone">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
                        <t t-out="tc_contact['phone']"/>
                    </a>
                </div>
                <nav aria-label="Information" style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 15px">
                    <a href="/delivery">Delivery &amp; Pickup</a>
                    <a href="/terms">Terms of Sale</a>
                    <a href="/privacy">Privacy Policy</a>
                    <a href="/about-us">About Us</a>
                </nav>
                <img src="/website_the_cut_pages/static/src/img/logo_white.png" alt="" loading="lazy"
                     width="96" height="96" style="width: 96px; height: 96px; display: block"/>
            </div>
        </footer>
    </template>

    <!-- Top of the Contact page (the form and the address below stay the Odoo page) -->
    <template id="contact_hero" name="The Cut: contact page top">
        <t t-set="tc" t-value="website._cut_values()"/>
        <t t-set="tc_btn" t-value="&quot;display: inline-flex; align-items: center; gap: 10px; padding: 14px 30px; min-height: 56px; box-sizing: border-box; text-decoration: none; font-family: Anton, Impact, 'Arial Narrow', sans-serif; font-size: 20px; letter-spacing: 0.05em; border-radius: 40px;&quot;"/>
        <section class="tc-root tc-contact-hero tc-pattern-red tc-top" style="background-color: #7E1416; color: #FFFFFF; border-top: 1px solid #94262A">
            <div style="max-width: 1120px; margin: 0 auto; padding: 56px 24px 64px">
                <h1 style="margin: 0; font-family: 'Capture it', Impact, sans-serif; font-weight: 400; font-size: clamp(44px, 10vw, 76px); line-height: 1; color: #FFFFFF">CONTACT US</h1>
                <p style="margin: 20px 0 0; max-width: 560px; font-size: 19px; color: #F3DCDC">A question about an order, a cut or a delivery? Message us, call us or send us the form below.</p>
                <p t-if="tc['opening']" style="margin: 8px 0 0; max-width: 560px; font-size: 16px; color: #F3DCDC">Our shop is open <t t-out="tc['opening']"/> to <t t-out="tc['closing']"/>, <t t-out="tc['open_days']"/>.</p>
                <div t-if="tc['whatsapp'] or tc['phone']" style="margin-top: 28px; display: flex; flex-wrap: wrap; gap: 14px">
                    <a t-if="tc['whatsapp']" t-att-href="tc['whatsapp_url'] or None"
                       t-attf-style="#{tc_btn} background: #FFFFFF; color: #7E1416; box-shadow: 0 6px 0 #5A0E10">
                        WHATSAPP <t t-out="tc['whatsapp']"/>
                    </a>
                    <a t-if="tc['phone']" t-att-href="tc['phone_url']"
                       t-attf-style="#{tc_btn} background: transparent; color: #FFFFFF; outline: 2px solid #FFFFFF; outline-offset: -2px">
                        CALL <t t-out="tc['phone']"/>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_direct_manufacturing.RawMaterialPopup">
        <Dialog title="'Select Raw Materials'">
            <div class="raw-material-popup p-2" t-ref="root">
                <div t-foreach="state.lines" t-as="line" t-key="line.id"
                     class="d-flex align-items-center gap-2 mb-2">
                    <div class="o_raw_material_search flex-grow-1 d-flex flex-wrap align-items-center gap-1"
                         t-att-data-line-id="line.id"
                         t-on-keydown="(ev) => this.onSearchKeydown(line, ev)">
                        <span t-foreach="line.terms" t-as="term" t-key="term_index"
                              class="o_raw_material_facet d-inline-flex align-items-center">
                            <t t-esc="term"/>
                            <i class="fa fa-times ms-1" role="button" title="Remove"
                               t-on-click="() => this.onRemoveTerm(line, term_index)"/>
                        </span>
                        <AutoComplete
                            value="line.productName"
                            sources="getSources(line)"
                            placeholder="line.terms.length ? 'Add another word...' : 'Search raw material...'"
                            menuCssClass="'o_raw_material_menu'"
                            class="'o_raw_material_input'"
                        />
                    </div>
                    <input type="number"
                           class="form-control"
                           style="width: 100px;"
                           t-att-value="line.qty"
                           t-on-change="(ev) => this.onQtyChange(line, ev)"
                           placeholder="Qty"/>
                    <button class="btn btn-sm btn-outline-danger"
                            t-on-click="() => this.onRemoveLine(line.id)">
                        ×
                    </button>
                </div>
                <button class="btn btn-sm btn-link" t-on-click="onAddLine">
                    + Add another material
                </button>
                <div t-if="state.errorMessage" class="alert alert-danger mt-2 mb-0 py-2">
                    <t t-esc="state.errorMessage"/>
                </div>
                <div t-if="state.warningMessage" class="alert alert-warning mt-2 mb-0 py-2" role="alert">
                    <t t-esc="state.warningMessage"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onCancel">Cancel</button>
                <button class="btn"
                        t-att-class="state.warningMessage ? 'btn-warning' : 'btn-primary'"
                        t-on-click="onConfirm"
                        t-esc="state.warningMessage ? 'Confirm anyway' : 'Confirm'"/>
            </t>
        </Dialog>
    </t>
</templates>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Placed right after the Routes block (not inside it), so the field
         gets its own "Raw Material Enforcement" label. It only shows once
         the Manufacture route applies, and appears/disappears live as the
         route is ticked or unticked. -->
    <record id="product_template_form_raw_material_enforcement" model="ir.ui.view">
        <field name="name">product.template.form.raw.material.enforcement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_ids']/parent::div" position="after">
                <field name="is_manufacture_route" invisible="1"/>
                <field name="raw_material_enforcement"
                       string="Raw Material Enforcement"
                       widget="radio"
                       invisible="not is_manufacture_route"/>
            </xpath>
        </field>
    </record>
</odoo>
<odoo>
    <record id="mrp_production_form_pos_smart_button" model="ir.ui.view">
        <field name="name">mrp.production.form.pos.smart.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pos_order" type="object"
                        class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="not pos_order_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">POS Order</span>
                        <span class="o_stat_value">
                            <field name="pos_order_id" readonly="1"
                                   options="{'no_open': True}"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
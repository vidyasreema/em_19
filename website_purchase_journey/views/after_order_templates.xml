<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Confirmation page: guests create their account in one tap (Annex 3 v2 §4.1) -->
    <template id="confirmation_guest_signup" inherit_id="website_sale.confirmation"
              name="Purchase Journey: sign up after ordering">
        <!-- Odoo's "Sign Up to follow your order" box: replaced by ours -->
        <xpath expr="//t[contains(@t-if, '_get_signup_invitation_scope')]" position="attributes">
            <attribute name="t-if" add="not website.journey_enabled" separator="and"/>
        </xpath>
        <xpath expr="//div[@id='order_name']" position="after">
            <t t-set="journey_signup" t-value="request.params.get('journey_signup')"/>
            <div t-if="journey_signup == 'done'" class="alert alert-success mb-4 o_journey_post_signup_done" role="status">
                <strong>Your account is created.</strong>
                We sent a link to <strong t-out="order.partner_id.email"/> to choose your password.
                <t t-if="website.sudo().journey_welcome_program_id.active">10% off your next order is waiting in My coupons.</t>
            </div>
            <div t-elif="journey_signup == 'error'" class="alert alert-warning mb-4" role="alert">
                We could not create your account. Please sign up from the
                <a href="/web/signup">sign-up page</a>.
            </div>
            <t t-elif="website.is_public_user()">
                <t t-set="journey_signup_state" t-value="order._journey_signup_state()"/>
                <section t-if="journey_signup_state == 'has_account'" class="card mb-4 o_journey_post_signin">
                    <div class="card-body">
                        <h5 class="card-title mb-1">You already have an account</h5>
                        <p class="text-muted mb-3">
                            <strong t-out="order.partner_id.email"/> is registered with us.
                            Sign in next time to use your saved addresses and coupons.
                        </p>
                        <a href="/web/login?redirect=/shop" class="btn btn-outline-primary w-100">Sign in</a>
                    </div>
                </section>
                <section t-elif="journey_signup_state == 'offer'"
                         class="card border-primary mb-4 o_journey_post_signup">
                    <div class="card-body">
                        <h5 class="card-title mb-1">
                            <t t-if="website.sudo().journey_welcome_program_id.active">Create an account to track this order and get 10% off your next order</t>
                            <t t-else="">Create an account to track this order</t>
                        </h5>
                        <p class="text-muted mb-3">One tap. We use <strong t-out="order.partner_id.email"/> from your order.</p>
                        <form action="/shop/order/signup" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary w-100 o_journey_post_signup_btn">Create my account</button>
                        </form>
                    </div>
                </section>
            </t>
        </xpath>
    </template>

    <!-- Shop: tracking bar for the open order (Annex 3 C6) -->
    <template id="products_tracking_bar" inherit_id="website_sale.products"
              name="Purchase Journey: tracking bar">
        <xpath expr="//div[@id='o_wsale_container']" position="before">
            <t t-set="journey_active_order" t-value="website._journey_active_order()"/>
            <div t-if="journey_active_order" class="container mt-3">
                <a t-att-href="journey_active_order._journey_track_url()"
                   class="d-flex align-items-center gap-3 rounded-3 px-3 py-2 text-decoration-none o_journey_track_bar">
                    <i class="fa fa-truck fa-lg" role="presentation"/>
                    <span class="flex-grow-1 min-w-0">
                        <small class="d-block">
                            Order <t t-out="journey_active_order.name"/>
                            <t t-if="journey_active_order.delivery_promise_date_label"> · <t t-out="journey_active_order.delivery_promise_date_label"/></t>
                        </small>
                        <strong class="o_journey_track_stage" t-out="journey_active_order._journey_track_stage()"/>
                    </span>
                    <span class="fw-bold text-decoration-underline">Track</span>
                </a>
            </div>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_journey" model="ir.ui.view">
        <field name="name">res.config.settings.form.purchase.journey</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="checkout_registration_setting" position="before">
                <setting id="purchase_journey_setting" string="New Purchase Journey"
                         help="Add from the shop, weight choice and location on entry. Untick to go back to the standard shop at once.">
                    <field name="journey_enabled"/>
                    <div class="mt-2" invisible="not journey_enabled">
                        <label for="journey_general_promise" string="Message without location" class="o_light_label"/>
                        <field name="journey_general_promise" class="w-100"/>
                        <label for="journey_whatsapp_number" string="WhatsApp help number" class="o_light_label mt-2"/>
                        <field name="journey_whatsapp_number" class="w-100" placeholder="+971 50 717 9729"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>

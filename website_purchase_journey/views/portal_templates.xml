<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Account: "My coupons" card -->
    <template id="portal_my_home_coupons" inherit_id="portal.portal_my_home" name="Purchase Journey: My coupons card">
        <div id="portal_common_category" position="inside">
            <t t-if="website.journey_enabled" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/loyalty/static/img/portal-loyalty.svg'"/>
                <t t-set="title">My coupons</t>
                <t t-set="text">Your coupon codes, ready to apply to your order</t>
                <t t-set="url" t-value="'/my/coupons'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_coupons" inherit_id="portal.portal_breadcrumbs" name="Purchase Journey: My coupons breadcrumb">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'journey_coupons'" class="breadcrumb-item">My coupons</li>
        </xpath>
    </template>

    <!-- My coupons (Annex 3 C5) -->
    <template id="portal_my_coupons" name="My coupons">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_journey_my_coupons">
                <h3 class="mt-3 mb-1">My coupons</h3>
                <p class="text-muted small mb-3">
                    Coupons apply to the full amount. Once delivery is free, they apply to
                    the amount above the free-delivery threshold.
                </p>
                <div t-if="coupon_error" class="alert alert-warning small" role="alert" t-out="coupon_error"/>
                <div t-if="not current_coupons" class="alert alert-light border" role="status">No coupons right now.</div>
                <div class="row g-3 mb-4">
                    <div t-foreach="current_coupons" t-as="coupon" class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 d-flex flex-column gap-1 o_journey_coupon_card">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h5 class="mb-0">
                                    <t t-out="coupon['title']"/>
                                    <span t-if="coupon['new']" class="badge rounded-pill text-bg-danger align-middle ms-1 o_journey_new_badge">New</span>
                                </h5>
                                <span t-attf-class="badge rounded-pill #{'text-bg-success' if coupon['state'] == 'current' else 'text-bg-warning'}"
                                      t-out="coupon['status']"/>
                            </div>
                            <div class="small text-muted" t-out="coupon['program']"/>
                            <div class="mt-1">
                                <span class="font-monospace fs-5 fw-bold user-select-all o_journey_coupon_code_value" t-out="coupon['code']"/>
                            </div>
                            <small class="text-muted" t-out="coupon['rule']"/>
                            <div class="mt-auto pt-2">
                                <span t-if="coupon['applied']" class="text-success small fw-bold">
                                    <i class="fa fa-check me-1"/>Applied to your order
                                </span>
                                <form t-elif="coupon['can_apply']" action="/my/coupons/apply" method="post" class="m-0">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="card_id" t-att-value="coupon['card'].id"/>
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 o_journey_coupon_use">Apply to my order</button>
                                </form>
                                <small t-elif="coupon['state'] == 'current'" class="text-muted">Add products to your cart to use it.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <t t-if="past_coupons">
                    <h5 class="text-muted mb-2">Used and expired</h5>
                    <t t-call="portal.portal_table">
                        <thead>
                            <tr><th>Coupon</th><th>Code</th><th class="text-end">Status</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="past_coupons" t-as="coupon">
                                <td t-out="coupon['title']"/>
                                <td class="font-monospace" t-out="coupon['code']"/>
                                <td class="text-end"><span class="badge text-bg-secondary" t-out="coupon['status']"/></td>
                            </tr>
                        </tbody>
                    </t>
                </t>
                <!-- New coupon (earned since the last visit): party popup, once per coupon -->
                <div t-if="new_coupons" class="modal fade o_journey_newcoupon_modal" tabindex="-1"
                     aria-labelledby="o_journey_newcoupon_title" aria-hidden="true"
                     t-att-data-card-ids="json.dumps([coupon['card'].id for coupon in new_coupons])">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body text-center p-4">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 o_journey_coupon_icon">
                                    <i class="fa fa-gift fa-2x" role="presentation"/>
                                </span>
                                <h4 class="mb-1" id="o_journey_newcoupon_title">
                                    <t t-if="len(new_coupons) == 1">🎉 You have a new coupon! 🎉</t>
                                    <t t-else="">🎉 You have <t t-out="len(new_coupons)"/> new coupons! 🎉</t>
                                </h4>
                                <p class="text-muted mb-3">Use it on your next order</p>
                                <div t-foreach="new_coupons" t-as="coupon" class="mb-3">
                                    <p class="fs-5 fw-bold text-primary mb-2" t-out="coupon['title']"/>
                                    <div class="d-flex align-items-center justify-content-between gap-2 rounded-3 px-3 py-2 o_journey_coupon_code_box">
                                        <span class="font-monospace fw-bold text-truncate" t-out="coupon['code']"/>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill o_journey_coupon_copy"
                                                t-att-data-code="coupon['code']">Copy</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Great!</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Welcome 10% given at sign-up (Annex 3 v2, task 4.2): one coupon per new
         customer account, applied to the cart right after signing up. -->
    <data noupdate="1">
        <record id="loyalty_program_welcome_signup" model="loyalty.program">
            <field name="name">Welcome 10% (sign-up)</field>
            <field name="program_type">coupons</field>
            <field name="trigger">with_code</field>
            <field name="applies_on">current</field>
            <field name="portal_visible" eval="True"/>
            <field name="rule_ids" eval="[(5, 0, 0), (0, 0, {'minimum_amount': 0.0, 'reward_point_amount': 1.0})]"/>
            <field name="reward_ids" eval="[(5, 0, 0), (0, 0, {
                'reward_type': 'discount',
                'discount': 10.0,
                'discount_mode': 'percent',
                'discount_applicability': 'order',
                'required_points': 1.0,
                'description': '10% off',
            })]"/>
        </record>
    </data>
    <!-- Websites without a welcome program get this one (kept if one was chosen) -->
    <function model="website" name="_journey_set_default_welcome_program"/>
</odoo>

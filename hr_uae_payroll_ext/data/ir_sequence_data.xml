<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_payroll_adjustment" model="ir.sequence">
        <field name="name">Payroll Addition/Deduction</field>
        <field name="code">hr.payroll.adjustment</field>
        <field name="prefix">ADJ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_employee_loan" model="ir.sequence">
        <field name="name">Employee Loan</field>
        <field name="code">hr.employee.loan</field>
        <field name="prefix">LOAN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_end_of_service" model="ir.sequence">
        <field name="name">End of Service</field>
        <field name="code">hr.end.of.service</field>
        <field name="prefix">EOS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

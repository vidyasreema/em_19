<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_salary_sheet_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.salary.sheet.form</field>
        <field name="model">hr.payroll.salary.sheet</field>
        <field name="arch" type="xml">
            <form string="Salary Sheet">
                <p class="text-muted">
                    One row per payslip of the period, grouped by department, with a column for each
                    addition and deduction. Opens in Excel or LibreOffice.
                </p>
                <group>
                    <group>
                        <label for="date_from" string="Period"/>
                        <div class="o_row">
                            <field name="date_from"/>
                            <span>to</span>
                            <field name="date_to"/>
                        </div>
                        <field name="include_draft"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_download" string="Download Excel" type="object" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_payroll_salary_sheet_action" model="ir.actions.act_window">
        <field name="name">Salary Sheet</field>
        <field name="res_model">hr.payroll.salary.sheet</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_payroll_salary_sheet"
              action="hr_payroll_salary_sheet_action"
              parent="hr_payroll.menu_hr_payroll_report"
              groups="hr_payroll.group_hr_payroll_user"
              sequence="5"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_view_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form.uae.payroll.ext</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_work_entry_holidays.work_entry_type_leave_form_inherit"/>
        <field name="arch" type="xml">
            <field name="work_entry_type_id" position="after">
                <field name="uae_pay_rate"/>
                <field name="uae_count_calendar_days"/>
                <field name="uae_days_per_contract"/>
                <field name="uae_min_service_months"/>
            </field>
        </field>
    </record>

    <record id="view_holiday_status_normal_tree" model="ir.ui.view">
        <field name="name">hr.leave.type.list.uae.payroll.ext</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <field name="leave_validation_type" position="after">
                <field name="uae_pay_rate" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
